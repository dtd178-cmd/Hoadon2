# Cấu hình máy chủ OCR nội bộ (Windows 10 / macOS Intel)
# Sao chép file này thành .env và thay đổi APP_API_TOKEN trước khi chạy

APP_HOST=127.0.0.1
APP_PORT=8000

# Khóa xác thực bắt buộc cho mọi request từ Frontend (iPhone / Windows / Cloudflare Pages)
APP_API_TOKEN=change-this-secret-token-before-production-2026

# Giới hạn an toàn tài nguyên
MAX_FILE_SIZE_MB=25
MAX_FILES_PER_BATCH=100
MAX_CONCURRENT_WORKERS=2
OCR_TIMEOUT_SECONDS=120

# Cấu hình PaddleOCR
PADDLE_OCR_LANG=vi
PADDLE_USE_GPU=false
PADDLE_USE_ANGLE_CLS=true
PDF_RENDER_DPI=200

# Bảo mật & Dọn dẹp
AUTO_CLEANUP_TEMP_FILES=true
LOG_REDACT_SENSITIVE=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
