# Cấu hình máy chủ OCR nội bộ (Windows 10 / macOS Intel)
# Sao chép file này thành .env (hoặc chạy scripts\setup_win10.bat)

APP_HOST=0.0.0.0
APP_PORT=8000

# Khóa xác thực cho mọi request từ Frontend (mặc định khớp với giao diện nội bộ; hãy đổi khi triển khai thực tế)
APP_API_TOKEN=vn-invoice-local-dev-token

# Giới hạn an toàn tài nguyên (hỗ trợ PDF lớn tới 30 MB và tối đa 50 trang/file)
MAX_FILE_SIZE_MB=30
MAX_PDF_PAGES=50
MAX_FILES_PER_BATCH=100
MAX_CONCURRENT_WORKERS=2
OCR_TIMEOUT_SECONDS=120

# Cấu hình PaddleOCR
PADDLE_OCR_LANG=vi
PADDLE_USE_GPU=false
PADDLE_USE_ANGLE_CLS=true
PDF_RENDER_DPI=200

# Bảo mật & Dọn dẹp
AUTO_CLEANUP_TEMP_FILES=true
LOG_REDACT_SENSITIVE=true
ALLOWED_ORIGINS=*
